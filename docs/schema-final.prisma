generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------
// Users
// personaId عمداً String است، نه enum: پرسوناها در یک فایل JSON
// تنظیمات تعریف می‌شوند (نه در دیتابیس)، تا تغییرشان migration نخواهد.
// ---------------------------------------------------------------
model User {
  id                 String    @id @default(uuid())
  authId             String?   @unique   // شناسه‌ی کاربر در سیستم احراز هویت (nullable تا زمان اتصال Auth.js)
  email              String    @unique
  passwordHash       String?                      // برای ورود با ایمیل/رمز (Auth.js credentials)
  displayName        String?
  timezone           String    @default("Asia/Tehran")

  personaId          String?                      // مثلاً "focused_structured" - از فایل JSON پرسوناها
  profileSource      String    @default("questionnaire") // بعداً: "ml_cluster"
  onboardingAnswers  Json?                        // پاسخ‌های خام پرسشنامه (برای تحلیل بعدی)

  // تم اپ - رنگ تأکید آزاد، حالت نمایش محدود به دو گزینه برای تضمین خوانایی
  themeAccent        String    @default("#7DD3C0")
  themeMode          String    @default("dark")   // "dark" | "light"

  consentBehaviorLog DateTime?                    // زمان رضایت به ثبت رفتار
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tasks              Task[]
  events             Event[]
  goals              Goal[]
  goalLogs           GoalLog[]

  @@index([personaId])
}

// ---------------------------------------------------------------
// Tasks: کارهای یک‌باره با ددلاین مشخص
// ---------------------------------------------------------------
model Task {
  id             String     @id @default(uuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  title          String
  description    String?
  status         TaskStatus @default(PENDING)

  deadline       DateTime?
  scheduledFor   DateTime?
  completedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  postponedCount Int        @default(0)

  parentTaskId   String?
  parent         Task?      @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subTasks       Task[]     @relation("SubTasks")

  createdByBreakdown Boolean @default(false)

  @@index([userId, status])
  @@index([userId, scheduledFor])
  @@index([parentTaskId])
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

// ---------------------------------------------------------------
// Goals: اهداف ادامه‌دار (یادگیری زبان، تمرین ویولن و ...)
// با Task فرق دارد: تمام‌شدنی نیست، هر بار که کاربر رویش کار می‌کند
// یک GoalLog ثبت می‌شود.
// ---------------------------------------------------------------
model Goal {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  title          String
  targetMinutesPerWeek Int?       // هدف هفتگی به دقیقه (برای داشبورد)
  targetDaysPerWeek    Int?       // یا هدف بر اساس تعداد روز
  reminderTime         String?    // ساعت یادآوری ثابت، مثلاً "07:30" (Local Notification)
  reminderDays          Int[]     @default([])  // روزهای هفته، 0=یکشنبه ... 6=شنبه

  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  logs           GoalLog[]

  @@index([userId, active])
}

// هر رکورد یعنی یک جلسه‌ی کار روی هدف
model GoalLog {
  id             String    @id @default(uuid())
  goalId         String
  goal           Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  durationMinutes Int
  note           String?                        // مثلاً "فصل سوم کتاب گرامر"
  loggedAt       DateTime  @default(now())

  @@index([goalId, loggedAt])
  @@index([userId, loggedAt])
}

// ---------------------------------------------------------------
// Events (Activity Log): مهم‌ترین جدول، فقط اضافه می‌شود (append-only)
// ---------------------------------------------------------------
model Event {
  id        BigInt   @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  eventType String   // task_completed, task_postponed, task_broken_down,
                     // notification_opened, notification_ignored, app_opened,
                     // goal_logged, onboarding_answered, ...
  taskId    String?  // اختیاری (بدون FK، تا حذف تسک لاگ را از بین نبرد)
  goalId    String?  // اختیاری، همین‌طور
  metadata  Json?
  timestamp DateTime @default(now())

  @@index([userId, timestamp])
  @@index([eventType, timestamp])
  @@index([taskId])
  @@index([goalId])
}
